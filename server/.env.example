# ==========================================
# PACIFIC CAPITAL NEWS - SERVER CONFIGURATION
# ==========================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security
JWT_SECRET=pacific_capital_secret_key_inst_auth_2026_x89
ADMIN_PASSWORD_HASH=

# BLOOMBERG DATA LICENSE / SAPI INTEGRATION
# Authorized Bloomberg Server API (SAPI) or Data License REST API credentials
# NOTE: If left empty or unauthorized, the platform strictly displays
# "LIVE DATA FEED NOT CONNECTED" per Bloomberg licensing requirements and never fabricates prices.
BLOOMBERG_ENABLED=false
BLOOMBERG_DL_ENDPOINT=https://dl.bloomberg.com/api/v1
BLOOMBERG_CLIENT_ID=
BLOOMBERG_CLIENT_SECRET=
BLOOMBERG_SAPI_HOST=
BLOOMBERG_SAPI_PORT=8194
BLOOMBERG_AUTH_TOKEN=

# PUBLIC FINANCIAL MARKET DATA ADAPTERS (For verified real live quotes)
# Crypto: Real-time CoinGecko API (No API key required for public tier)
COINGECKO_ENABLED=true

# Forex & Indices: Yahoo Finance / Open Exchange / Stooq verified live fetchers
FINANCIAL_DATA_PROVIDER=live_public_verified

# Financial News Ingestion Feeds (RSS/Atom from verified financial wires)
ENABLE_RSS_INGESTION=true
RSS_FETCH_INTERVAL_MS=300000

# Redis Cache (Optional: Falls back to in-memory institutional cache)
REDIS_URL=redis://localhost:6379
USE_REDIS=false
