{
  "name": "pacific-capital-news",
  "version": "1.0.0",
  "type": "module",
  "description": "Pacific Capital News - Global Financial News & Market Intelligence Platform",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && node index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "vercel-build": "cd client && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "rss-parser": "^3.13.0",
    "uuid": "^9.0.1",
    "ws": "^8.17.0"
  }
}
